---
/**
 * A Stripe-style parameter list rendered from src/data/schemas.ts.
 *
 * <Fields schema="InitiatePayment" />
 *
 * Fields with child parameters get a "Show child parameters" toggle that expands the nested
 * object inline, recursively, so readers never have to leave the page.
 */
import { schemas, type Field } from '../data/schemas';
import { renderMarkdown } from '../lib/markdown';

interface Props {
  schema: string;
  /** Prefix for field anchors, e.g. "payment" gives #payment-amount. Defaults to the schema name. */
  idPrefix?: string;
  /** Top-level fields to leave out, e.g. ['token'] on SDK pages where the SDK computes it. */
  omit?: string[];
  /** Nesting depth; set by the component itself. */
  depth?: number;
}

const { schema: name, omit = [], depth = 0 } = Astro.props;
const schema = (schemas as Record<string, { kind: string; fields: Field[] }>)[name];
if (!schema) {
  throw new Error(`<Fields>: unknown schema "${name}". Add it to src/data/schemas.ts.`);
}
const idPrefix = Astro.props.idPrefix ?? name.toLowerCase();

const unknownOmit = omit.filter((key) => !schema.fields.some((field) => field.name === key));
if (unknownOmit.length > 0) {
  throw new Error(`<Fields schema="${name}">: can't omit unknown fields ${unknownOmit.join(', ')}`);
}

const fields = await Promise.all(
  schema.fields.filter((field) => !omit.includes(field.name)).map(async (field) => ({
    ...field,
    id: `${idPrefix}-${field.name}`,
    html: await renderMarkdown(field.description),
    enumHtml: field.enum
      ? await Promise.all(
          field.enum.map(async (item) => ({ ...item, html: await renderMarkdown(item.description) }))
        )
      : undefined,
  }))
);
---

<ul class:list={['pp-fields', 'not-content', { 'pp-fields--nested': depth > 0 }]}>
  {
    fields.map((field) => (
      <li class="pp-field" id={field.id}>
        <div class="pp-field__head">
          <a class="pp-field__name" href={`#${field.id}`}>
            <code>{field.name}</code>
          </a>
          <span class="pp-field__type">{field.type}</span>
          {field.required && <span class="pp-field__tag pp-field__tag--required">Required</span>}
          {field.requiredIf && (
            <span class="pp-field__tag pp-field__tag--required">Required if {field.requiredIf}</span>
          )}
          {field.optional && <span class="pp-field__tag">Optional</span>}
        </div>
        <div class="pp-field__desc" set:html={field.html} />

        {field.enumHtml && (
          <div class="pp-field__enum">
            <p class="pp-field__enum-title">Possible values</p>
            <dl>
              {field.enumHtml.map((item) => (
                <div>
                  <dt>
                    <code>{item.value}</code>
                  </dt>
                  <dd set:html={item.html} />
                </div>
              ))}
            </dl>
          </div>
        )}

        {field.children && (
          <details class="pp-field__children">
            <summary>
              <span class="pp-show">Show child parameters</span>
              <span class="pp-hide">Hide child parameters</span>
            </summary>
            <Astro.self schema={field.children} idPrefix={field.id} depth={depth + 1} />
          </details>
        )}
      </li>
    ))
  }
</ul>

<style is:global>
  .pp-fields {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .pp-field {
    margin: 0;
    padding: 1rem 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
  }
  .pp-field:target {
    background: linear-gradient(90deg, var(--sl-color-accent-low), transparent);
  }
  .pp-field__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.625rem;
  }
  .pp-field__name {
    text-decoration: none;
  }
  .pp-field__name code {
    font-weight: 700;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
    background: none;
    padding: 0;
  }
  .pp-field__name:hover code {
    text-decoration: underline 2px var(--sl-color-accent);
    text-underline-offset: 3px;
  }
  .pp-field__type {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .pp-field__tag {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-gray-3);
  }
  .pp-field__tag--required {
    color: var(--sl-color-white);
    padding: 0 0.5rem;
    border-radius: var(--pp-radius-pill);
    background-color: var(--sl-color-accent-low);
  }
  :root[data-theme='light'] .pp-field__tag--required {
    background-color: #fde9a6;
  }
  .pp-field__desc {
    margin-top: 0.375rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .pp-field__desc :is(p, ul) {
    margin: 0 0 0.5rem;
  }
  .pp-field__desc > :last-child {
    margin-bottom: 0;
  }
  .pp-field__desc a,
  .pp-field__enum a {
    color: var(--sl-color-white);
    text-decoration: underline 2px var(--sl-color-accent);
    text-underline-offset: 3px;
  }
  .pp-field__desc code,
  .pp-field__enum code {
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background-color: var(--sl-color-gray-6);
    overflow-wrap: anywhere;
  }

  .pp-field__enum {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
  }
  .pp-field__enum-title {
    margin: 0 0 0.375rem;
    font-weight: 600;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .pp-field__enum dl {
    margin: 0;
    display: grid;
    gap: 0.375rem;
  }
  .pp-field__enum dl > div {
    display: grid;
    grid-template-columns: minmax(0, max-content) 1fr;
    gap: 0.75rem;
  }
  .pp-field__enum dt code {
    font-weight: 600;
  }
  .pp-field__enum dd {
    margin: 0;
    color: var(--sl-color-gray-2);
  }
  .pp-field__enum dd p {
    margin: 0;
  }
  @media (max-width: 40rem) {
    .pp-field__enum dl > div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  /* Child parameters: a pill toggle that opens a bordered, nested list. */
  .pp-field__children {
    margin-top: 0.75rem;
  }
  .pp-field__children > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    list-style: none;
    cursor: pointer;
    padding: 0.25rem 0.875rem;
    border-radius: var(--pp-radius-pill);
    box-shadow: inset 0 0 0 1.5px var(--sl-color-gray-5);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-white);
    user-select: none;
  }
  .pp-field__children > summary::-webkit-details-marker {
    display: none;
  }
  .pp-field__children > summary::before {
    content: '+';
    font-weight: 700;
  }
  .pp-field__children[open] > summary::before {
    content: '−';
  }
  .pp-field__children > summary:hover {
    box-shadow: inset 0 0 0 1.5px var(--sl-color-white);
  }
  .pp-field__children > summary:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .pp-field__children .pp-hide,
  .pp-field__children[open] .pp-show {
    display: none;
  }
  .pp-field__children[open] .pp-hide {
    display: inline;
  }
  .pp-field__children[open] > summary {
    border-radius: 12px 12px 0 0;
    box-shadow: none;
    border: 1.5px solid var(--sl-color-gray-5);
    border-bottom: none;
  }
  .pp-fields--nested {
    margin: 0;
    padding: 0 1rem;
    border: 1.5px solid var(--sl-color-gray-5);
    border-radius: 0 12px 12px 12px;
  }
  .pp-fields--nested > .pp-field:last-child {
    border-bottom: none;
  }
</style>
